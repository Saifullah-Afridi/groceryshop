generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// id is the link name made from the category name, e.g. "fresh-juices" (used in /shop?category=...)
model Category {
  id          String    @id
  name        String
  nameAr      String    @default("")
  description String    @default("")
  descriptionAr String  @default("")
  icon        String    @default("Carrot")
  color       String    @default("#138040")
  tint        String    @default("#dff3e0")
  image       String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id          Int      @id @default(autoincrement())
  name        String
  nameAr      String   @default("")
  description String   @default("")
  descriptionAr String @default("")
  farm        String   @default("")
  price       Decimal  @db.Decimal(10, 2) // JOD per 0.25 kg, as set in the admin form
  unit        String   @default("kg")
  minQuantity Float    @default(0) // low-stock alert threshold in product units; 0 disables the alert
  stockQuantity Float  @default(0) // available inventory; kg for kg products
  discount    Float    @default(0) // one percentage discount (0-100) applied to the whole price
  image       String?
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
}

// A shopper. The password is stored hashed. The email must be verified with a 6-digit code before they can order.
model Customer {
  id            Int       @id @default(autoincrement())
  name          String
  email         String    @unique
  passwordHash  String
  phone         String    @default("")
  address       String
  emailVerified Boolean   @default(false)
  otpHash       String? // the pending 6-digit code, hashed
  otpExpiresAt  DateTime?
  otpAttempts   Int       @default(0)
  otpSentAt     DateTime?
  orders        Order[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// A city we deliver to. The admin sets the delivery fee here.
model City {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  fee       Decimal  @db.Decimal(10, 2) // JOD
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

// The delivery details and every amount are copied onto the order, so later edits to a customer,
// product price or city fee never change an order that was already placed.
model Order {
  id          Int         @id @default(autoincrement())
  customerId  Int?
  customer    Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name        String
  phone       String
  address     String
  city        String
  note        String      @default("")
  subtotal    Decimal     @db.Decimal(10, 2)
  deliveryFee Decimal     @db.Decimal(10, 2)
  total       Decimal     @db.Decimal(10, 2)
  status      OrderStatus @default(PENDING)
  items       OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([customerId])
  @@index([status])
}

model OrderItem {
  id          Int     @id @default(autoincrement())
  orderId     Int
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   Int? // kept for reference only, the product may be deleted later
  productName String
  unit        String
  unitPrice   Decimal @db.Decimal(10, 2) // price per 0.25 kg (or per piece) when the order was placed
  quantity    Float // kg for weighed products, otherwise pieces
  lineTotal   Decimal @db.Decimal(10, 2)
}
