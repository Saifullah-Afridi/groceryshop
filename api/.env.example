PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# =====================================================================
# 1) DATABASE. Supabase dashboard > Connect > tab "Direct" > Type "URI"
#    Use the "Session pooler" string. Replace PROJECT_REF, REGION and YOUR_PASSWORD.
#    If the password has special characters (@ : / # ?), percent-encode them.
# =====================================================================
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# =====================================================================
# 2) IMAGE STORAGE. Supabase dashboard > Connect > tab "Server"
#    Copy SUPABASE_URL and SUPABASE_SECRET_KEY from there (click the eye icon to reveal the secret key).
#    SUPABASE_PUBLISHABLE_KEY and SUPABASE_JWKS_URL are NOT used by this API. Leave them out.
#    PROJECT_REF must be the SAME as in DATABASE_URL above.
# =====================================================================
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."

# The bucket is not a key. It is a folder name that YOU create:
# Supabase dashboard > Storage > New bucket > name it exactly "rakan" > turn ON "Public bucket" > Create.
SUPABASE_BUCKET="rakan"

# =====================================================================
# 3) ADMIN LOGIN. Change the password and the secret before the site goes live.
#    Make a secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =====================================================================
JWT_SECRET="change-this-to-a-long-random-string"
ADMIN_EMAIL="admin@gmail.com"
ADMIN_PASSWORD="admin@gmail.com"

# =====================================================================
# 4) EMAIL for the 6-digit verification codes.
#    Leave SMTP_HOST empty while developing: the code is printed in this terminal instead.
#    Gmail example: smtp.gmail.com, port 587, your Gmail address, and an App Password
#    (Google account > Security > 2-Step Verification > App passwords).
# =====================================================================
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Rakan <you@gmail.com>"
